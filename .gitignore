# Python
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.pytest_cache/

# Virtual environments. The project's venv lives outside the repo
# (~/venvs/rfd3-pipeline) because this tree is OneDrive-synced and because
# deep site-packages paths hit the Windows MAX_PATH limit here; these patterns
# cover the case where someone creates one in-tree anyway.
.venv/
venv/
env/

# Local runs and scratch output
out/
outputs/
*.log

# Structures pulled off the volume to look at. Derived artifacts -- every one
# is reproducible with `modal volume get`, and CIFs are large enough that
# committing them would bloat an already OneDrive-synced tree.
structures/

# Probe scratch: the files worth keeping are copied into tests/fixtures/
experiments/rfd3_output/
